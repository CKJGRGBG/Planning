['Actual', 'AUD', 'Gross Sales'],
['Actual', 'AUD', 'COGS']
;

['Budget', 'CAD', 'Gross Sales']=>
['Budget', 'AUD', 'Gross Sales'],
['Budget', 'AUD', 'COGS']
