['Actual']=>
['LY Actual'], ['Actual Inc Budget'],['Actual v LY Actual ($)'],['Actual v LY Actual (%)'], ['Forecast'];

['Budget']=>
['Actual Inc Budget'],
['Budget v LY Actual ($)'],
['Budget v LY Actual (%)'];

['Forecast']=>
['Actual Inc Forecast'];

['Budget','Gross Sales']=>['Budget','COGS'];