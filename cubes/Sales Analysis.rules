['Forecast', 'AUD', 'COGS']
;

['Actual', 'JPY', 'Gross Sales']=>
['Actual', 'AUD', 'Gross Sales'],
['Actual', 'AUD', 'COGS']
;

['Budget', 'JPY', 'Gross Sales']=>
['Budget', 'AUD', 'Gross Sales'],
['Budget', 'AUD', 'COGS']
