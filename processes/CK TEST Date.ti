#region Prolog

nUTCDateFormatId = NewDateFormatter('en-AU', 'Australia/Sydney', 'serial', '', 'datetime');
sDatePattern = 'yyyy-MM-dd';
sMonthPattern = 'MMM';
sYearPattern = 'YY';
 
nYDay = Now() - 1;
sYesterday = FormatDate( nYDay, sDatePattern, nUTCDateFormatId );
sYesterdayMthNm = FormatDate( nYDay, sMonthPattern, nUTCDateFormatId );
nYesterdayMthNo = Month(sYesterday);
sYesterdayYear = FormatDate( nYDay, sYearPattern, nUTCDateFormatId );
nYesterdayYear = StringToNumber(sYesterdayYear);

ASCIIOutput( 'CKTestDate.csv', 'Yesterday ', sYesterday );
ASCIIOutput( 'CKTestDate.csv', 'Yesterday (Mth Nm) ', sYesterdayMthNm );
ASCIIOutput( 'CKTestDate.csv', 'Yesterday (Mth No) ', NumberToString(nYesterdayMthNo));

if (nYesterdayMthNo > 6); 
    nYesterdayYear = nYesterdayYear + 1; 
endif;

sYesterdayYear = 'FY'|NumberToString(nYesterdayYear);

ASCIIOutput( 'CKTestDate.csv', 'Yesterday (Year) ', sYesterdayYear);

#endregion