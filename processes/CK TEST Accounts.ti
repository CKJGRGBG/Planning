#region Prolog


#Region Define Variables

cDim1 = 'Account GL';
cDim2 = 'Account BS';
cDim3 = 'Account PnL';
cOrphan = 'Orphan';
#EndRegion

#endregion
#region Metadata

#Region Account GL
IF ( DimensionElementExists ( cDim1, cOrphan)=0);
    DimensionElementInsert ( cDim1, '', cOrphan, 'C');
ENDIF ;    

IF (DIMIX ( cDim1, Code) = 0);
    DimensionElementInsert ( cDim1, '', Code, 'N' ) ;
    DimensionElementComponentAdd ( cDim1, cOrphan, Code, 1);
ENDIF;    
#EndRegion

#Region Account BS
IF (DIMIX ( cDim2, Code) = 0);
    DimensionElementInsert ( cDim2, '', Code, 'N' ) ;
    DimensionElementComponentAdd ( cDim2, cOrphan, Code, 1);
ENDIF;    

IF ( DimensionElementExists ( cDim2, cOrphan)=0);
    DimensionElementInsert ( cDim2, '', cOrphan, 'C');
ENDIF ;    
#EndRegion

#Region Account PnL
IF ( DimensionElementExists ( cDim3, cOrphan)=0);
    DimensionElementInsert ( cDim3, '', cOrphan, 'C');
ENDIF ;    

IF (DIMIX ( cDim3, Code) = 0);
    DimensionElementInsert ( cDim3, '', Code, 'N' ) ;
    DimensionElementComponentAdd ( cDim3, cOrphan, Code, 1);
ENDIF;    
#EndRegion

#endregion
#region Data

#Region Account GL
IF (DIMIX ( cDim1, Code) <> 0);
    AttrPutS( Name, cDim1, Code, 'Description' );
    AttrPutS( Type, cDim1, Code, 'Type' );
    AttrPutS( Code | ' - ' | Name, cDim1, Code, 'Num + Description' );    
ENDIF;    
#EndRegion

#Region Account BS
IF (DIMIX ( cDim2, Code) <> 0);
    AttrPutS( Name, cDim2, Code, 'Description' );
    AttrPutS( Type, cDim2, Code, 'Type' );
    AttrPutS( Code | ' - ' | Name, cDim2, Code, 'Num + Description' );    
ENDIF;    
#EndRegion

#Region Account PnL
IF (DIMIX ( cDim3, Code) <> 0);
    AttrPutS( Name, cDim3, Code, 'Description' );
    AttrPutS( Type, cDim3, Code, 'Type' );
    AttrPutS( Code | ' - ' | Name, cDim3, Code, 'Num + Description' );    
ENDIF;    
#EndRegion

#endregion