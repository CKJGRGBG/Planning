#region Prolog
#Region #Define Constants and variables
    cProcess = GetProcessName();
    cDimMeasure = 'Inventory Analysis Measure';
    cCub = 'Inventory Analysis';
    cCubDist = 'DEM Distribution Centre Mapping';
    cView = cCub | cProcess | ' ClearCurrentPeriod';
    pPeriodClear = pMth |  ' ' | pFY;
#EndRegion

#Region #Datasource
ODBCOpen('BromicConnection2', 'bromicadmin', 'RSTUSHr9S@Rg');
DatasourcePassword = 'RSTUSHr9S@Rg';
#EndRegion

#Region #Send Parameters to query
    # vinvoiced_yr =pFY;
    # vinvoiced_mth = pMth;
#EndRegion 

#Region # Create View and Clear data
    #Create View and clear
        ExecuteProcess( '}bedrock.cube.view.create', 
        'pLogOutput', 0,
        'pStrictErrorHandling', 0,
        'pCube', cCub, 
        'pView', cView, 
        'pFilter', cDimMeasure | '¦ Quantity + Stock Cost' | '&' | 'Year' | '¦' |  pFY | '&' | 'Month' | '¦' |  pMth ,                       
        'pSuppressZero', 1, 
        'pSuppressConsol', 1, 
        'pSuppressRules', 1, 
        'pSuppressConsolStrings', 1,
        'pDimDelim', '&', 
        'pEleStartDelim', '¦', 
        'pEleDelim', '+',
        'pTemp', 1, 
        'pSubN', 0
        );
    
    #Clear Data        
        ViewZeroOut( cCub, cView );
#EndRegion



#endregion
#region Data

#Lookup Dist Centre
    vDist = CellGetS( cCubDist, entity_code, distribution_center, 'Distribution Centre Mapping'  );

    IF (DIMIX ('DEM Distribution Centre Detail', distribution_center) = 0);
         AsciiOutPut ('Inventory DC Mapping unknown.txt', entity_code, FinYear, Mth , item_no, distribution_center,vDist);
     ENDIF ;

    IF (DIMIX ('Product', item_no)>0);
          CellIncrementN( on_hand_quantity, cCub, entity_code, FinYear, Mth, item_no, currency_local, vDist, 'Quantity' );
          CellIncrementN( on_hand_cost_local, cCub, entity_code, FinYear, Mth, item_no, currency_local, vDist, 'Stock Cost' );
    ENDIF ;


#endregion